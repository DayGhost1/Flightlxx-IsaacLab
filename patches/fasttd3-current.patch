+    def _mark_failure_context(
+        self,
+        ptr: int,
+        dones: torch.Tensor,
+        truncations: torch.Tensor,
+    ) -> None:
+        """Mark a short causal window ending at each physical failure.
+
+        A timeout has both ``done`` and ``truncation`` set and is therefore only
+        an episode boundary, not a failure.  Backtracking stops before an older
+        terminal transition so context never leaks across episodes.
+        """
+
+        failed = dones.bool().reshape(-1) & ~truncations.bool().reshape(-1)
+        failed_envs = torch.nonzero(failed, as_tuple=False).squeeze(-1).tolist()
+        if not failed_envs:
+            return
+        max_back = min(
+            self.failure_context_steps - 1,
+            self.buffer_size - 1,
+            self.ptr if self.ptr < self.buffer_size else self.buffer_size - 1,
+        )
+        for env_id in failed_envs:
+            self.failure_contexts[env_id, ptr] = 1
+            for offset in range(1, max_back + 1):
+                index = (ptr - offset) % self.buffer_size
+                if self.dones[env_id, index] or self.truncations[env_id, index]:
+                    break
+                self.failure_contexts[env_id, index] = 1
+
+    @staticmethod
+    def _quota_counts(total: int, fractions: tuple[float, ...]) -> list[int]:
+        raw = torch.tensor(fractions, dtype=torch.float64) * total
+        counts = torch.floor(raw).to(torch.long)
+        remainder = total - int(counts.sum().item())
+        if remainder > 0:
+            order = torch.argsort(raw - counts, descending=True)
+            counts[order[:remainder]] += 1
+        return [int(value) for value in counts.tolist()]
+
+    @classmethod
+    def _allocate_with_capacities(cls, total: int, capacities: list[int]) -> list[int]:
+        """Allocate an integer quota proportionally without exceeding capacities."""
+
+        allocated = [0 for _ in capacities]
+        remaining = total
+        while remaining > 0:
+            available = [
+                index
+                for index, capacity in enumerate(capacities)
+                if allocated[index] < capacity
+            ]
+            if not available:
+                break
+            spare = [capacities[index] - allocated[index] for index in available]
+            spare_total = sum(spare)
+            proposal = cls._quota_counts(
+                remaining, tuple(value / spare_total for value in spare)
+            )
+            progressed = 0
+            for local_index, index in enumerate(available):
+                addition = min(proposal[local_index], capacities[index] - allocated[index])
+                allocated[index] += addition
+                progressed += addition
+            if progressed == 0:
+                break
+            remaining -= progressed
+        return allocated
+
+    def _draw(self, candidates: torch.Tensor, count: int) -> torch.Tensor:
+        if count <= 0:
+            return torch.empty(0, device=self.device, dtype=torch.long)
+        return candidates[
+            torch.randint(0, candidates.numel(), (count,), device=self.device)
+        ]
