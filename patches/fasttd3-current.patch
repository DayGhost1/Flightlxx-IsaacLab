+    def _fallback_candidates(
+        self,
+        labels: torch.Tensor,
+        requested_band: int,
+        excluded: torch.Tensor,
+    ) -> torch.Tensor:
+        current = torch.nonzero((labels == 3) & ~excluded, as_tuple=False).squeeze(-1)
+        if current.numel() > 0:
+            return current
+        other_impacts = torch.nonzero(
+            (labels > 0) & (labels != requested_band) & ~excluded,
+            as_tuple=False,
+        ).squeeze(-1)
+        if other_impacts.numel() > 0:
+            return other_impacts
+        any_non_excluded = torch.nonzero(~excluded, as_tuple=False).squeeze(-1)
+        if any_non_excluded.numel() > 0:
+            return any_non_excluded
+        return torch.arange(labels.numel(), device=self.device)
