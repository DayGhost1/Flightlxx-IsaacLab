new file mode 100644
index 0000000..364ed47
--- /dev/null
+++ b/fast_td3/local_logging.py
@@ -0,0 +1,197 @@
+"""Local, reproducible training artifacts for FastTD3 runs.
+
+The upstream implementation treats Weights & Biases as the only metric sink and
+stores all checkpoints in one global directory.  This module keeps every run in
+its own timestamped directory and always provides a plain CSV log.  TensorBoard
+is enabled when its optional dependency is available.
+"""
+
+from __future__ import annotations
+
+import csv
+import json
+import math
+import re
+import sys
+from dataclasses import dataclass
+from datetime import datetime
+from pathlib import Path
+from typing import Any, Mapping, TextIO
+
+
+@dataclass(frozen=True)
+class RunPaths:
+    run_dir: Path
+    logs_dir: Path
+    tensorboard_dir: Path
+    checkpoints_dir: Path
+    progress_csv: Path
+    config_json: Path
+
+
+def _safe_component(value: str) -> str:
+    cleaned = re.sub(r"[^A-Za-z0-9_.-]+", "_", value).strip("._")
+    return cleaned or "run"
+
+
+def create_run_paths(
+    output_root: str | Path,
+    env_name: str,
+    seed: int,
+    now: datetime | None = None,
+) -> RunPaths:
+    """Create one collision-safe, timestamped artifact directory."""
+
+    timestamp = (now or datetime.now()).strftime("%Y%m%d_%H%M%S")
+    parent = Path(output_root).expanduser() / _safe_component(env_name)
+    base_name = f"{timestamp}_seed{seed}"
+    run_dir = parent / base_name
+    collision = 1
+    while run_dir.exists():
+        run_dir = parent / f"{base_name}_{collision:02d}"
+        collision += 1
+
+    logs_dir = run_dir / "logs"
+    tensorboard_dir = run_dir / "tensorboard"
+    checkpoints_dir = run_dir / "checkpoints"
+    for directory in (logs_dir, tensorboard_dir, checkpoints_dir):
+        directory.mkdir(parents=True, exist_ok=False)
+
+    return RunPaths(
+        run_dir=run_dir,
+        logs_dir=logs_dir,
+        tensorboard_dir=tensorboard_dir,
+        checkpoints_dir=checkpoints_dir,
+        progress_csv=logs_dir / "progress.csv",
+        config_json=run_dir / "config.json",
+    )
+
+
+def _scalar(value: Any) -> float | int | None:
+    """Convert Python/NumPy/Torch scalar-like values without importing Torch."""
+
+    if isinstance(value, bool):
+        return int(value)
+    if isinstance(value, (int, float)):
+        scalar = value
+    elif hasattr(value, "numel") and callable(value.numel):
+        if value.numel() != 1:
+            return None
+        scalar = value.detach().item() if hasattr(value, "detach") else value.item()
+    elif hasattr(value, "item") and callable(value.item):
+        try:
+            scalar = value.item()
+        except (TypeError, ValueError):
+            return None
+    else:
+        return None
+    if isinstance(scalar, (int, float)) and math.isfinite(float(scalar)):
+        return scalar
+    return None
+
+
+class _DynamicCsvWriter:
+    """Wide CSV writer whose schema can grow when Isaac Lab emits new metrics."""
+
+    def __init__(self, path: Path):
+        self.path = path
+        self.fieldnames: list[str] = []
+
+    def write(self, row: Mapping[str, float | int]) -> None:
+        new_fields = [name for name in row if name not in self.fieldnames]
+        if not self.fieldnames:
+            self.fieldnames = list(row)
+            self._rewrite([dict(row)])
+            return
+        if new_fields:
+            existing = []
+            with self.path.open(newline="", encoding="utf-8") as handle:
+                existing.extend(csv.DictReader(handle))
+            self.fieldnames.extend(new_fields)
+            existing.append(dict(row))
+            self._rewrite(existing)
+            return
+        with self.path.open("a", newline="", encoding="utf-8") as handle:
+            writer = csv.DictWriter(handle, fieldnames=self.fieldnames)
+            writer.writerow(row)
+
+    def _rewrite(self, rows: list[Mapping[str, Any]]) -> None:
+        with self.path.open("w", newline="", encoding="utf-8") as handle:
+            writer = csv.DictWriter(handle, fieldnames=self.fieldnames)
+            writer.writeheader()
+            writer.writerows(rows)
+
+
+class LocalTrainingLogger:
+    """Write console, progress.csv and TensorBoard metrics for one run."""
+
+    _CONSOLE_PRIORITY = (
+        "frame",
+        "train/sample_sps",
+        "env_rewards",
+        "episode_return_mean",
+        "episode_length_mean",
+        "actor_loss",
+        "qf_loss",
+        "q1_q2_gap",
+        "support_boundary_probability",
+        "Curriculum/difficulty",
+        "Metrics/success_recovery",
+        "Metrics/post_impact_crash_rate",
+    )
+
+    def __init__(
+        self,
+        paths: RunPaths,
+        config: Mapping[str, Any],
+        *,
+        enable_tensorboard: bool = True,
+        stream: TextIO | None = None,
+        summary_writer: Any | None = None,
+    ):
+        self.paths = paths
+        self.stream = stream or sys.stdout
+        self.csv = _DynamicCsvWriter(paths.progress_csv)
+        self.closed = False
+        paths.config_json.write_text(
+            json.dumps(dict(config), indent=2, ensure_ascii=False, default=str) + "\n",
+            encoding="utf-8",
+        )
+        self.summary_writer = summary_writer
+        if self.summary_writer is None and enable_tensorboard:
+            try:
+                from torch.utils.tensorboard import SummaryWriter
+
+                self.summary_writer = SummaryWriter(log_dir=str(paths.tensorboard_dir))
+            except (ImportError, ModuleNotFoundError) as exc:
+                print(f"TensorBoard disabled: {exc}", file=self.stream)
+
+    def log(self, step: int, metrics: Mapping[str, Any]) -> None:
+        scalars: dict[str, float | int] = {"step": int(step)}
+        for name, value in metrics.items():
+            scalar = _scalar(value)
+            if scalar is not None:
+                scalars[name] = scalar
+        self.csv.write(scalars)
+
+        if self.summary_writer is not None:
+            for name, value in scalars.items():
+                if name != "step":
+                    self.summary_writer.add_scalar(name, value, step)
+            self.summary_writer.flush()
+
+        visible = [
+            f"{name}={float(scalars[name]):.5g}"
+            for name in self._CONSOLE_PRIORITY
+            if name in scalars
+        ]
+        print(f"[train] step {step}: " + ", ".join(visible), file=self.stream)
+
+    def close(self) -> None:
+        if self.closed:
+            return
+        if self.summary_writer is not None:
+            self.summary_writer.flush()
+            self.summary_writer.close()
+        self.closed = True
+
