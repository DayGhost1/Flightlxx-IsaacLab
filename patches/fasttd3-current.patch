+def replay_log_metrics(replay) -> dict[str, float]:
+    """Format measured Replay occupancy and last-sample statistics for logging."""
+
+    diagnostics = replay.diagnostics()
+    samples = replay.last_sample_stats
+    logs = {
+        f"Replay/{name}": float(value)
+        for name, value in {**diagnostics, **samples}.items()
+    }
