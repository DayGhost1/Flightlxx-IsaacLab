new file mode 100644
index 0000000..814db7b
--- /dev/null
+++ b/fast_td3/round_reporting.py
@@ -0,0 +1,105 @@
+"""Self-contained per-round reports from local FastTD3 artifacts."""
+
+from __future__ import annotations
+
+import csv
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+
+@dataclass(frozen=True)
+class RoundReportPaths:
+    markdown: Path
+    summary_csv: Path
+    training_reward_png: Path
+    recovery_png: Path
+
+
+def _read_csv(path: Path) -> list[dict[str, str]]:
+    if not path.exists():
+        return []
+    with path.open(newline="", encoding="utf-8") as handle:
+        return list(csv.DictReader(handle))
+
+
+def _number(row: dict[str, str], key: str, default: float = 0.0) -> float:
+    try:
+        return float(row.get(key, default))
+    except (TypeError, ValueError):
+        return default
+
+
+def _plot_training(rows: list[dict[str, str]], path: Path) -> None:
+    import matplotlib
+
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+
+    fig, axis = plt.subplots(figsize=(7, 3.5))
+    axis.plot([_number(row, "step") for row in rows], [_number(row, "train/reward") for row in rows])
+    axis.set(xlabel="global step", ylabel="mean environment reward", title="Training reward")
+    axis.grid(alpha=0.3)
+    fig.tight_layout()
+    fig.savefig(path, dpi=160)
+    plt.close(fig)
+
+
+def _plot_recovery(rows: list[dict[str, str]], path: Path) -> None:
+    import matplotlib
+
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+
+    steps = [_number(row, "checkpoint_step") for row in rows]
+    recovered = [_number(row, "recovered_count") for row in rows]
+    crashed = [_number(row, "crashed") for row in rows]
+    fig, axis = plt.subplots(figsize=(7, 3.5))
+    axis.plot(steps, recovered, marker="o", label="recovered impacts / 5")
+    axis.plot(steps, crashed, marker="x", label="crashed (1=yes)")
+    axis.set(xlabel="checkpoint step", ylabel="count / flag", title="Fixed five-impact evaluation")
+    axis.set_ylim(-0.2, 5.2)
+    axis.grid(alpha=0.3)
+    axis.legend()
+    fig.tight_layout()
+    fig.savefig(path, dpi=160)
+    plt.close(fig)
+
+
+def write_round_report(run_dir: str | Path) -> RoundReportPaths:
+    """Generate a concise round report; input data are never modified."""
+
+    run_dir = Path(run_dir)
+    reports_dir = run_dir / "reports"
+    reports_dir.mkdir(parents=True, exist_ok=True)
+    training_rows = _read_csv(run_dir / "logs" / "progress.csv")
+    evaluation_rows = _read_csv(run_dir / "evaluation" / "summary.csv")
+    summary_csv = reports_dir / "summary.csv"
+    with summary_csv.open("w", newline="", encoding="utf-8") as handle:
+        if evaluation_rows:
+            writer = csv.DictWriter(handle, fieldnames=list(evaluation_rows[0]))
+            writer.writeheader()
+            writer.writerows(evaluation_rows)
+        else:
+            handle.write("checkpoint_step,passed,recovered_count,crashed\n")
+
+    training_png = reports_dir / "training_reward.png"
+    recovery_png = reports_dir / "five_impact_recovery.png"
+    _plot_training(training_rows, training_png)
+    _plot_recovery(evaluation_rows, recovery_png)
+    best = max(evaluation_rows, key=lambda row: (_number(row, "recovered_count"), -_number(row, "crashed")), default=None)
+    markdown = reports_dir / "round_report.md"
+    markdown.write_text(
+        "# FastTD3 fixed-five-impact round report\n\n"
+        f"- Training log records: {len(training_rows)}\n"
+        f"- Checkpoint evaluations: {len(evaluation_rows)}\n"
+        + (
+            f"- Best checkpoint: {best.get('checkpoint_step')} "
+            f"({best.get('recovered_count')}/5 recovered, passed={best.get('passed')})\n"
+            if best is not None
+            else "- Best checkpoint: none\n"
+        )
+        + "\n![Training reward](training_reward.png)\n\n![Five-impact recovery](five_impact_recovery.png)\n",
+        encoding="utf-8",
+    )
+    return RoundReportPaths(markdown, summary_csv, training_png, recovery_png)
